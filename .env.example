# ==========================================================
# Variables de Entorno para Despliegue en Hetzner (Opcional)
# Copia este archivo a .env si deseas personalizar claves:
# cp .env.example .env
# ==========================================================

# Puerto público HTTP (80 por defecto para entrar con http://TU_IP_HETZNER)
HTTP_PORT=80

# Configuración PostgreSQL 17
DB_NAME=smakbot_db
DB_USER=postgres
DB_PASSWORD=SmakbotProd2026!

# Perfil de Spring Boot (dev incluye las semillas + config sandbox WhatsApp V100)
SPRING_PROFILE=dev

# Redis Caché & Sesiones
REDIS_ENABLED=true

# Despacho saliente hacia Meta WhatsApp Cloud API
META_OUTBOUND_ENABLED=true
ADMIN_ORIGINS=*

