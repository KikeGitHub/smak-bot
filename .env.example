# ==========================================================
# Variables de Entorno para Despliegue en Hetzner (5.161.82.24)
# Modo Low-Memory (< 650 MB RAM total) en puerto aislado 8090
# ==========================================================

# Puerto público HTTP aislado (8090 para no chocar con /opt/iit_pickup en el puerto 80/443)
HTTP_PORT=8090

# Configuración PostgreSQL 17 (Red interna smakbot_net, sin exponer 5432 al host)
DB_NAME=smakbot_db
DB_USER=postgres
DB_PASSWORD=SmakbotProd2026!

# Perfil de Spring Boot (dev incluye las semillas + config sandbox WhatsApp V100)
SPRING_PROFILE=dev

# Redis Caché & Sesiones (limitado a 20 MB en RAM)
REDIS_ENABLED=true

# Despacho saliente hacia Meta WhatsApp Cloud API
META_OUTBOUND_ENABLED=true
ADMIN_ORIGINS=*

# Plantilla Carrusel Meta WhatsApp (Opcional para mostrar galería en tarjetas deslizables)
# Dejar vacío para usar el envío nativo de álbum de WhatsApp automático
META_CAROUSEL_TEMPLATE_NAME=
META_CAROUSEL_TEMPLATE_LANG=es

# OpenAI GPT-4o-mini (Conversación fluida + Transcripción de notas de voz)
OPENAI_API_KEY=sk-proj-TU_API_KEY_AQUI
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Cloudinary CDN (Almacenamiento y optimización de hasta 5 imágenes por producto)
CLOUDINARY_CLOUD_NAME=lealtix-media
CLOUDINARY_API_KEY=912463379929212
CLOUDINARY_SECRET=9CmlnIrFnEf4wbPISatNAAopJjU
CLOUDINARY_URL=cloudinary://912463379929212:9CmlnIrFnEf4wbPISatNAAopJjU@lealtix-media
CLOUDINARY_FOLDER=smak
UPLOAD_DIR=/app/uploads


